{
  "name": "@vnpykit/runtime-pyodide",
  "version": "0.1.0-alpha.1",
  "description": "Worker-first Pyodide runtime for VNPyKit browser applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "keywords": ["vnpykit", "pyodide", "web-worker", "python", "webassembly"],
  "repository": { "type": "git", "url": "git+https://github.com/visionnumbers/vnpykit.git", "directory": "packages/runtime-pyodide" },
  "homepage": "https://github.com/visionnumbers/vnpykit#readme",
  "bugs": { "url": "https://github.com/visionnumbers/vnpykit/issues" },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vnpykit/protocol": "workspace:*",
    "@vnpykit/renderer": "workspace:*",
    "pyodide": "314.0.7"
  },
  "license": "Apache-2.0",
  "engines": { "node": ">=24.0.0" }
}
