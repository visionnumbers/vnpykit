{
  "name": "@vnpykit/cli",
  "version": "0.1.0-alpha.1",
  "description": "CLI for creating, serving, and building VNPyKit browser applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "vnpykit": "./dist/bin.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "assets", "README.md"],
  "keywords": ["vnpykit", "cli", "pyodide", "python", "static-site"],
  "repository": { "type": "git", "url": "git+https://github.com/visionnumbers/vnpykit.git", "directory": "packages/cli" },
  "homepage": "https://github.com/visionnumbers/vnpykit#readme",
  "bugs": { "url": "https://github.com/visionnumbers/vnpykit/issues" },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "node scripts/prepare-release-assets.mjs && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vnpykit/embed": "workspace:*",
    "pyodide": "314.0.7"
  },
  "devDependencies": { "@types/node": "24.10.13" },
  "license": "Apache-2.0",
  "engines": { "node": ">=24.0.0" }
}
