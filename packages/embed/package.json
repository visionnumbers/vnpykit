{
  "name": "@vnpykit/embed",
  "version": "0.1.0-alpha.1",
  "description": "Framework-independent browser embedding API for VNPyKit",
  "type": "module",
  "main": "./dist/vnpykit.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/vnpykit.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "keywords": ["vnpykit", "embed", "pyodide", "python", "browser"],
  "repository": { "type": "git", "url": "git+https://github.com/visionnumbers/vnpykit.git", "directory": "packages/embed" },
  "homepage": "https://github.com/visionnumbers/vnpykit#readme",
  "bugs": { "url": "https://github.com/visionnumbers/vnpykit/issues" },
  "publishConfig": { "access": "public", "tag": "alpha" },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json --emitDeclarationOnly && vite build && vite build --config vite.worker.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@vnpykit/runtime-pyodide": "workspace:*",
    "vite": "8.3.4"
  },
  "license": "Apache-2.0",
  "engines": { "node": ">=24.0.0" }
}
