{
  "name": "@vnpykit/renderer",
  "version": "0.1.0-alpha.1",
  "description": "Safe DOM renderer for VNPyKit protocol v1 applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "keywords": ["vnpykit", "renderer", "dom", "pyodide", "typescript"],
  "repository": { "type": "git", "url": "git+https://github.com/visionnumbers/vnpykit.git", "directory": "packages/renderer" },
  "homepage": "https://github.com/visionnumbers/vnpykit#readme",
  "bugs": { "url": "https://github.com/visionnumbers/vnpykit/issues" },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": { "@vnpykit/protocol": "workspace:*" },
  "license": "Apache-2.0",
  "engines": { "node": ">=24.0.0" }
}
