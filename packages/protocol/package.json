{
  "name": "@vnpykit/protocol",
  "version": "0.1.0-alpha.1",
  "description": "Validated protocol v1 contracts for VNPyKit browser runtimes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "keywords": ["vnpykit", "protocol", "pyodide", "browser", "typescript"],
  "repository": { "type": "git", "url": "git+https://github.com/visionnumbers/vnpykit.git", "directory": "packages/protocol" },
  "homepage": "https://github.com/visionnumbers/vnpykit#readme",
  "bugs": { "url": "https://github.com/visionnumbers/vnpykit/issues" },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "Apache-2.0",
  "engines": { "node": ">=24.0.0" }
}
